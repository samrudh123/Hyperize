+// ── local patch ────────────────────────────────────────────────────────────
+// Right-click bookkeeping.
+//
+// THE BUG THIS FIXES
+// appContextMenu() builds a fresh gtk.Menu on every right-click and nothing
+// ever destroyed it. Two consequences, both of which you can see:
+//
+//  1. A GtkMenu takes a pointer grab while it is up, so the tile under the
+//     cursor never receives its leave-notify-event and stays stuck in
+//     PRELIGHT — it looks selected permanently. Right-click a second app and
+//     you have two "selected" tiles; they accumulate for the lifetime of the
+//     drawer, because nothing ever clears the state.
+//  2. Every one of those menus leaks — a GtkMenu plus its items, plus a
+//     reference on the tile it was attached to. That is the slowdown: the
+//     grid gets heavier with each right-click.
+//
+// Fix: keep at most ONE menu alive. Pop the previous one down and destroy it
+// before showing a new one, and explicitly clear the forced state flags on
+// the tile it was attached to.
+//
+// Destruction is deferred with glib.IdleAdd rather than called inline: on the
+// "deactivate" path we are inside the menu's own signal emission, and freeing
+// the widget there risks GTK touching memory it has just dropped. Idle runs
+// once the current emission has unwound, which is also after a chosen item's
+// "activate" handler, so Open/favourites/sidebar still fire.
+var (
+	openMenu       *gtk.Menu
+	openMenuWidget gtk.Widgetter
+)
+
+// clearTileHighlight undoes the state the menu's pointer grab left behind.
+func clearTileHighlight() {
+	if openMenuWidget == nil {
+		return
+	}
+	gtk.BaseWidget(openMenuWidget).UnsetStateFlags(
+		gtk.StateFlagPrelight | gtk.StateFlagActive | gtk.StateFlagSelected)
+	openMenuWidget = nil
+}
+
+// popupAppMenu shows menu at widget, replacing whatever was open before.
+func popupAppMenu(menu *gtk.Menu, at gtk.Widgetter) {
+	if openMenu != nil {
+		prev := openMenu
+		openMenu = nil
+		prev.Popdown()
+		glib.IdleAdd(func() { prev.Destroy() })
+	}
+	// Clear the OLD tile before adopting the new one — this is what stops the
+	// selections from piling up.
+	clearTileHighlight()
+
+	openMenu = menu
+	openMenuWidget = at
+
+	// "deactivate" fires on every dismissal: Escape, click-away, or an item
+	// being chosen.
+	menu.Connect("deactivate", func() {
+		clearTileHighlight()
+		if openMenu == menu {
+			openMenu = nil
+		}
+		glib.IdleAdd(func() { menu.Destroy() })
+	})
+
+	menu.PopupAtWidget(at, gdk.GravitySouth, gdk.GravityNorth, nil)
+}
+
+// ── local patch ────────────────────────────────────────────────────────────
+// Upstream 0.7.5 toggles the favourites row directly on right-click, with no
+// menu at all. This is the GNOME-style context menu instead.
+func appContextMenu(desktopID, execCmd string, terminal bool) *gtk.Menu {
+	menu := gtk.NewMenu()
+
+	itemOpen := gtk.NewMenuItemWithLabel("Open")
+	itemOpen.Connect("activate", func() { launch(execCmd, terminal, true) })
+	menu.Append(itemOpen)
+
+	sep := gtk.NewSeparatorMenuItem()
+	menu.Append(&sep.MenuItem)
+
+	// Favourites = the drawer's own row, ~/.cache/nwg-pin-cache.
+	inFav := isIn(pinned, desktopID)
+	favLabel := "Add to favourites"
+	if inFav {
+		favLabel = "Remove from favourites"
+	}
+	itemFav := gtk.NewMenuItemWithLabel(favLabel)
+	itemFav.Connect("activate", func() {
+		if inFav {
+			unpinItem(desktopID)
+		} else {
+			pinItem(desktopID)
+		}
+	})
+	menu.Append(itemFav)
+
+	// Sidebar = nwg-dock, ~/.cache/nwg-dock-pinned, keyed by window class.
+	sidebarLabel, action := "Pin to sidebar", "add"
+	if dockPinStatus(desktopID) == "pinned" {
+		sidebarLabel, action = "Unpin from sidebar", "remove"
+	}
+	itemSide := gtk.NewMenuItemWithLabel(sidebarLabel)
+	itemSide.Connect("activate", func() { dockPinSet(action, desktopID) })
+	menu.Append(itemSide)
+
+	menu.ShowAll()
+	return menu
+}
