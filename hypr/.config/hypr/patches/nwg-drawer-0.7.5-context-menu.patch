+// ── local patch ────────────────────────────────────────────────────────────
+// The SIDEBAR (nwg-dock) keeps its own pinned list, keyed by WINDOW CLASS
+// rather than .desktop ID, and there is no dependable static mapping between
+// the two. Delegate to ~/.config/hypr/dock-pin.sh, which resolves the class
+// against running windows / StartupWMClass / X-SnapInstanceName.
+func dockPinScript() string {
+	return filepath.Join(os.Getenv("HOME"), ".config", "hypr", "dock-pin.sh")
+}
+
+func dockPinStatus(desktopID string) string {
+	out, err := exec.Command(dockPinScript(), "status", desktopID).Output()
+	if err != nil {
+		log.Warnf("dock-pin.sh status failed: %s", err)
+		return "unknown"
+	}
+	return strings.TrimSpace(string(out))
+}
+
+func dockPinSet(action, desktopID string) {
+	if err := exec.Command(dockPinScript(), action, desktopID).Run(); err != nil {
+		log.Warnf("dock-pin.sh %s failed: %s", action, err)
+	}
+}
