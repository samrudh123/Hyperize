+
+// ── local patch: bottom entries + drag-to-reorder ──────────────────────────
+//
+// Reordering here deliberately does NOT use GTK drag-and-drop. A GTK drag is
+// wl_data_device.start_drag, which puts the whole seat into a drag grab; on a
+// layer-shell surface with no keyboard interactivity there is then no way to
+// cancel it, and a drop that never completes freezes the entire desktop. That
+// happened, and cost a logout.
+//
+// What is used instead is the ordinary press/motion/release an unmodified
+// button already gets. The implicit pointer grab that comes with a button press
+// is always released on button-up by the compositor, so the worst case here is
+// a wrong reorder or a swallowed click — never a stuck session.
+//
+// Gated behind -reorder so it can be switched off by editing the dock's
+// arguments, without rebuilding.
+
+type reorderItem struct {
+	id  string
+	btn *gtk.Button
+}
+
+var (
+	reorderItems  []reorderItem
+	reorderSrc    string
+	reorderActive bool
+	reorderStartY float64
+)
+
+const reorderThreshold = 8.0 // px of movement before a click becomes a drag
+
+// isBottomPin reports whether a pin belongs in the bottom group (-bottom).
+func isBottomPin(name string) bool {
+	if *bottomEntries == "" {
+		return false
+	}
+	for _, p := range strings.Split(*bottomEntries, ",") {
+		p = strings.TrimSpace(p)
+		if p != "" && strings.HasPrefix(name, p) {
+			return true
+		}
+	}
+	return false
+}
+
+func makeReorderable(button *gtk.Button, id string) {
+	// Not pinned => no line in the file to move. In the bottom group => the
+	// user asked for those to stay put.
+	if !*reorder || !isIn(pinned, id) || isBottomPin(id) {
+		return
+	}
+	reorderItems = append(reorderItems, reorderItem{id: id, btn: button})
+	button.AddEvents(int(gdk.PointerMotionMask))
+
+	// y of the pointer in toplevel coordinates: the event is relative to the
+	// button, the allocation places the button in the window.
+	pointerY := func(b *gtk.Button, local float64) float64 {
+		return float64(b.Allocation().Y()) + local
+	}
+
+	button.Connect("button-press-event", func(b *gtk.Button, e *gdk.Event) bool {
+		ev := e.AsButton()
+		if ev.Button() == 1 {
+			reorderSrc = id
+			reorderActive = false
+			reorderStartY = pointerY(b, ev.Y())
+		}
+		return false // let the button behave normally
+	})
+
+	button.Connect("motion-notify-event", func(b *gtk.Button, e *gdk.Event) bool {
+		if reorderSrc != id {
+			return false
+		}
+		d := pointerY(b, e.AsMotion().Y()) - reorderStartY
+		if d < 0 {
+			d = -d
+		}
+		if d > reorderThreshold {
+			reorderActive = true
+		}
+		return false
+	})
+
+	// Connected before the existing release handler, so returning true here
+	// stops the emission and the app is not launched for what was a drag.
+	button.Connect("button-release-event", func(b *gtk.Button, e *gdk.Event) bool {
+		if !reorderActive || reorderSrc != id {
+			reorderSrc, reorderActive = "", false
+			return false
+		}
+		y := int(pointerY(b, e.AsButton().Y()))
+		target := ""
+		for _, it := range reorderItems {
+			a := it.btn.Allocation()
+			if y >= a.Y() && y < a.Y()+a.Height() {
+				target = it.id
+				break
+			}
+		}
+		src := reorderSrc
+		reorderSrc, reorderActive = "", false
+		if target != "" && target != src {
+			reorderPinned(src, target)
+		}
+		return true
+	})
+}
+
+// reorderPinned moves src to where dst currently sits and saves the list.
+// savePinned() rewrites the file and the fsnotify watcher rebuilds the dock.
+func reorderPinned(src, dst string) {
+	if src == "" || dst == "" || src == dst {
+		return
+	}
+
+	var without []string
+	for _, v := range pinned {
+		if v != src {
+			without = append(without, v)
+		}
+	}
+
+	idx := -1
+	for i, v := range without {
+		if v == dst {
+			idx = i
+			break
+		}
+	}
+	if idx < 0 {
+		return
+	}
+
+	out := make([]string, 0, len(without)+1)
+	out = append(out, without[:idx]...)
+	out = append(out, src)
+	out = append(out, without[idx:]...)
+
+	pinned = out
+	savePinned()
+	log.Debugf("Moved %s to the position of %s", src, dst)
+}
