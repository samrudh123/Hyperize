+	// ── local patch ──────────────────────────────────────────────────────────
+	// buildMainBox() re-reads pinnedFile every time, but it only ever runs via
+	// refreshMainBox, which fires on an `activewindowv2` event carrying a NEW
+	// window address. So anything editing ~/.cache/nwg-dock-pinned from the
+	// outside — dock-pin.sh from the drawer's context menu, dock-places.sh, a
+	// hand edit — left the dock drawing a stale icon list until the user
+	// happened to focus a different window. Watch the file and rebuild at once.
+	//
+	// The DIRECTORY is watched rather than the file: the helper scripts replace
+	// it with mv, which swaps the inode and would silently kill a file watch.
+	go func() {
+		w, err := fsnotify.NewWatcher()
+		if err != nil {
+			log.Warnf("Couldn't create the pinned-file watcher: %s", err)
+			return
+		}
+		defer w.Close()
+		dir := filepath.Dir(pinnedFile)
+		if err := w.Add(dir); err != nil {
+			log.Warnf("Couldn't watch %s: %s", dir, err)
+			return
+		}
+		log.Debugf("Watching %s for changes to %s", dir, pinnedFile)
+		// TRAILING-edge debounce. One append or mv emits several events, and
+		// the early ones can arrive before the new content is all there — so
+		// rebuild once the file has been quiet for a moment, rather than
+		// rebuilding on the first event and dropping the rest (which left the
+		// dock rendering the previous state, one change behind).
+		var timer *time.Timer
+		for {
+			select {
+			case event := <-w.Events:
+				if event.Name != pinnedFile {
+					continue
+				}
+				if timer != nil {
+					timer.Stop()
+				}
+				timer = time.AfterFunc(200*time.Millisecond, func() {
+					log.Debug("Pinned file settled, rebuilding the dock")
+					refreshMainBox(true)
+				})
+			case err := <-w.Errors:
+				log.Warnf("Pinned-file watcher: %s", err)
+			}
+		}
+	}()
+
