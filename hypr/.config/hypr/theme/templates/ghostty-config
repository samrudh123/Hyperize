# ─── Ghostty · Catppuccin Mocha ───────────────────────────────────────────

font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-feature = calt
font-feature = liga
font-thicken = true

# Catppuccin Mocha
background = 1e1e2e
foreground = cdd6f4
# Accent — filled in by set-accent.sh; SIGUSR2 reloads open windows
cursor-color = @@ACCENT@@
cursor-text = 11111b
# selected text turns accent on a muted band, rather than an accent slab
selection-background = 45475a
selection-foreground = @@ACCENT@@
split-divider-color = @@ACCENT@@
unfocused-split-fill = 11111b
# Ctrl+Shift+F search: matches muted, the current match in the accent
search-background = 585b70
search-foreground = cdd6f4
search-selected-background = @@ACCENT@@
search-selected-foreground = 11111b

palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8
# accent slots in the 256-colour cube, for the shell (starship prompt,
# fastfetch, eza, completion, fzf all draw with 38;5;53-56). Text keeps the
# palette INDEX, so a reload (set-accent.sh sends SIGUSR2) recolours
# everything already on screen, scrollback included.
palette = 53=#@@ACCENT@@
palette = 54=#@@ACCENT_COMP@@
palette = 55=#@@ACCENT_MID@@
palette = 56=#@@ACCENT_LOW@@

# ─── Look & feel ──────────────────────────────────────────────────────────
background-opacity = 0.92
background-blur-radius = 32
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = true
window-theme = ghostty
gtk-titlebar = false
unfocused-split-opacity = 0.7

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
scrollback-limit = 100000
copy-on-select = clipboard
confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ─── Keybinds ─────────────────────────────────────────────────────────────
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
