# zathura — PDF viewer, themed with the rest of the desktop.
#
# ⚠ This file is RENDERED by ~/.config/hypr/set-accent.sh from
# hypr/theme/templates/zathurarc on every theme (SUPER+T) or accent
# (SUPER+ALT+C) change. After editing it run
#     ~/.config/hypr/set-accent.sh --resync
# or the edit is lost on the next change. Colours are written as Catppuccin
# Mocha roles (rice-theme.py maps them to the current theme), plus the
# accent token. The VS Code "PDF in Zathura" extension reads this file too.

set font                    "JetBrainsMono Nerd Font 11"
set selection-clipboard     clipboard
set statusbar-home-tilde    true
set window-title-home-tilde true
set window-title-basename   true
set statusbar-h-padding     10
set statusbar-v-padding     4
set page-v-padding          10
set page-h-padding          10
set scroll-page-aware       true
set incremental-search      true

# zathura 2026.02 throws away every page's rendered image on each scroll step
# and repaints from its thumbnail until the re-render lands. Thumbnails over
# this many pixels are stored downscaled (blurry) and never refreshed, so they
# also keep the colours from before a `w` toggle. 8 MP (default 4 MP) covers a
# fit-width A4 page on this 1920x1200 screen, so the thumbnail IS the full-res
# page: no blur, and it follows recolour. Costs up to 32 MB per page viewed.
set page-thumbnail-size     8388608

# --- colours ------------------------------------------------------------------
# the window is crust, so the (recoloured, base) pages stand out as sheets
set default-bg              "#11111b"
set default-fg              "#cdd6f4"

set statusbar-bg            "#181825"
set statusbar-fg            "#cdd6f4"
set inputbar-bg             "#11111b"
set inputbar-fg             "#cdd6f4"

set notification-bg         "#313244"
set notification-fg         "#cdd6f4"
set notification-error-bg   "#313244"
set notification-error-fg   "#f38ba8"
set notification-warning-bg "#313244"
set notification-warning-fg "#f9e2af"

set completion-bg           "#313244"
set completion-fg           "#cdd6f4"
set completion-group-bg     "#181825"
set completion-group-fg     "#@@ACCENT@@"
set completion-highlight-bg "#@@ACCENT@@"
set completion-highlight-fg "#1e1e2e"

set index-bg                "#1e1e2e"
set index-fg                "#cdd6f4"
set index-active-bg         "#@@ACCENT@@"
set index-active-fg         "#1e1e2e"

# search matches (and link-hint labels): every hit yellow, the current one
# peach — translucent, so rgba() of Mocha roles rather than the accent token
set highlight-color         "rgba(249, 226, 175, 0.5)"
set highlight-active-color  "rgba(250, 179, 135, 0.7)"
set highlight-fg            "#1e1e2e"

set render-loading-bg       "#1e1e2e"
set render-loading-fg       "#cdd6f4"

# Pages in the theme's colours: paper -> base, ink -> text; keephue keeps
# coloured text, links and logos coloured. Ctrl+R flips to the original white
# pages and back. reverse-video (images left untouched) stays OFF: it leaves
# every logo, banner and white-backed figure as a glaring white box. For a
# photo-heavy document, `:set recolor-reverse-video true` in that window.
set recolor                 true
set recolor-keephue         true
set recolor-reverse-video   false
set recolor-lightcolor      "#1e1e2e"
set recolor-darkcolor       "#cdd6f4"

# w: toggle between the themed pages and the PDF's original colours (Ctrl+R
# does the same). The VS Code viewer picks this up too.
map w recolor
map [fullscreen] w recolor
