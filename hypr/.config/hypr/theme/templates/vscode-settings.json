{
    // ── Theme ───────────────────────────────────────────────────────────────
    // Catppuccin Mocha, the same palette ghostty and yazi already use — base
    // #1e1e2e, text #cdd6f4 — so the editor stops being the one window that
    // disagrees with the rest of the desktop.
    // Mocha in dark mode, Latte in light (both recoloured into the theme by
    // the overrides below) — @@FLAVOUR@@ is filled by set-accent.sh.
    "workbench.colorTheme": "Catppuccin @@FLAVOUR@@",
    "workbench.iconTheme": "catppuccin-@@FLAVOUR_ID@@",

    // Left at the extension's default ON PURPOSE: that default is mauve, which
    // is the very colour set-accent.sh calls ORIGINAL — so when the
    // desktop accent is the stock one, the ~60 accent-tinted keys this file
    // does NOT override still agree with the ones it does. See the block at
    // the bottom for why it is only some of them.
    "catppuccin.accentColor": "blue",
    // Desktop THEMES (SUPER+SHIFT+T): the theme's palette, both flavours at
    // once — "mocha" = its dark palette, "latte" = its light one (tokens from
    // rice-theme.py derive). The Catppuccin extension recompiles its theme
    // files when THIS block changes (a theme switch: "Reload required"), but
    // a dark <-> light switch (Settings › Appearance › Mode) only changes
    // workbench.colorTheme below, between two already-compiled themes —
    // VS Code applies that live, no reload. At Mocha the mocha block is the
    // stock palette.
    "catppuccin.colorOverrides": {
        "mocha": {
            "rosewater": "#@@DARK_ROSEWATER@@",
            "flamingo": "#@@DARK_FLAMINGO@@",
            "pink": "#@@DARK_PINK@@",
            "mauve": "#@@DARK_MAUVE@@",
            "red": "#@@DARK_RED@@",
            "maroon": "#@@DARK_MAROON@@",
            "peach": "#@@DARK_PEACH@@",
            "yellow": "#@@DARK_YELLOW@@",
            "green": "#@@DARK_GREEN@@",
            "teal": "#@@DARK_TEAL@@",
            "sky": "#@@DARK_SKY@@",
            "sapphire": "#@@DARK_SAPPHIRE@@",
            "blue": "#@@DARK_BLUE@@",
            "lavender": "#@@DARK_LAVENDER@@",
            "text": "#@@DARK_TEXT@@",
            "subtext1": "#@@DARK_SUBTEXT1@@",
            "subtext0": "#@@DARK_SUBTEXT0@@",
            "overlay2": "#@@DARK_OVERLAY2@@",
            "overlay1": "#@@DARK_OVERLAY1@@",
            "overlay0": "#@@DARK_OVERLAY0@@",
            "surface2": "#@@DARK_SURFACE2@@",
            "surface1": "#@@DARK_SURFACE1@@",
            "surface0": "#@@DARK_SURFACE0@@",
            "base": "#@@DARK_BASE@@",
            "mantle": "#@@DARK_MANTLE@@",
            "crust": "#@@DARK_CRUST@@"
        },
        "latte": {
            "rosewater": "#@@LIGHT_ROSEWATER@@",
            "flamingo": "#@@LIGHT_FLAMINGO@@",
            "pink": "#@@LIGHT_PINK@@",
            "mauve": "#@@LIGHT_MAUVE@@",
            "red": "#@@LIGHT_RED@@",
            "maroon": "#@@LIGHT_MAROON@@",
            "peach": "#@@LIGHT_PEACH@@",
            "yellow": "#@@LIGHT_YELLOW@@",
            "green": "#@@LIGHT_GREEN@@",
            "teal": "#@@LIGHT_TEAL@@",
            "sky": "#@@LIGHT_SKY@@",
            "sapphire": "#@@LIGHT_SAPPHIRE@@",
            "blue": "#@@LIGHT_BLUE@@",
            "lavender": "#@@LIGHT_LAVENDER@@",
            "text": "#@@LIGHT_TEXT@@",
            "subtext1": "#@@LIGHT_SUBTEXT1@@",
            "subtext0": "#@@LIGHT_SUBTEXT0@@",
            "overlay2": "#@@LIGHT_OVERLAY2@@",
            "overlay1": "#@@LIGHT_OVERLAY1@@",
            "overlay0": "#@@LIGHT_OVERLAY0@@",
            "surface2": "#@@LIGHT_SURFACE2@@",
            "surface1": "#@@LIGHT_SURFACE1@@",
            "surface0": "#@@LIGHT_SURFACE0@@",
            "base": "#@@LIGHT_BASE@@",
            "mantle": "#@@LIGHT_MANTLE@@",
            "crust": "#@@LIGHT_CRUST@@"
        }
    },

    // ── Type ────────────────────────────────────────────────────────────────
    // Same face and features as ghostty's config (font-feature = calt, liga),
    // so code looks identical in the editor and in a terminal beside it.
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'Droid Sans Mono', monospace",
    "editor.fontLigatures": true,
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",

    // VS Code draws its own title bar instead of letting GTK draw a grey one,
    // so the window is themed edge to edge like everything else here. The menu
    // bar becomes a hamburger at the top left; Alt still opens it.
    "window.titleBarStyle": "custom",

    // ── Sizing for a 162 DPI panel ──────────────────────────────────────────
    // This display is 1920x1200 on 14", and Hyprland runs it at scale 1.0, so
    // nothing scales the UI up. VS Code sizes its chrome in raw pixels (13px
    // UI font, 16px icons), which lands ~13% smaller than GTK apps here
    // (Ubuntu Sans 11pt = 14.7px) and much smaller than the dock's icons.
    //
    // zoomLevel is the right knob: it scales EVERYTHING together — icons,
    // tabs, sidebar, menus, editor — where editor.fontSize only touches code.
    // Each step is 1.2x, so 2 = 144%. Nudge it live with Ctrl+= / Ctrl+-
    // (View > Appearance > Zoom In); VS Code writes the new value back here.
    "window.zoomLevel": 2,

    // Code text, scaled on top of the zoom above (14 x 1.44 = ~20px effective).
    "editor.fontSize": 14,
    "terminal.integrated.fontSize": 14,
    // No automatic contrast boost: the shell's accent colours are palette
    // slots that set-accent.sh rewrites live (OSC 4), and xterm.js keeps its
    // contrast decisions cached across that — the prompt's directory text
    // stayed "lightened" against the OLD colour, washed out on the new one.
    "terminal.integrated.minimumContrastRatio": 1,
    // No sticky scroll: the pinned prompt it draws at the top is a separate
    // xterm that never receives those OSC 4 colours, so the prompt showed in
    // the stock palette's dark magentas/violets instead of the accent.
    "terminal.integrated.stickyScroll.enabled": false,

    // ── existing settings, unchanged ────────────────────────────────────────
    "claudeCode.preferredLocation": "panel",
    "colab.serverMounting": true,
    "git.autofetch": true,
    "claudeCode.hideOnboarding": true,

    // PDFs open in the zathura-style viewer (~/.config/vscode-pdf-zathura),
    // not tomoki1207.pdf, which also claims *.pdf.
    "workbench.editorAssociations": {
        "*.pdf": "pdfZathura.view"
    },

    // ── Stop the home directory being indexed ───────────────────────────────
    // $HOME is open as the workspace folder, so VS Code's file indexer walked
    // ALL of it — measured: miniconda3 106k inodes, miniforge3 108k, snap 144k,
    // .cache 45k, plus .vscode-server/ROCmFuzz/.texlive2025 (too big to finish
    // counting). It ran `rg --files --hidden --no-ignore --follow`, i.e. with
    // .gitignore disabled AND symlinks followed, and sat at >1000% CPU
    // (multi-core) indefinitely. Killing it did nothing: the extension host
    // respawned a fresh rg within two seconds, so the only real fix is to stop
    // giving it the work.
    //
    // followSymlinks is the single biggest win. A conda prefix is a forest of
    // symlinks (lib/libX11.so.6 -> libX11.so.6.4.0, and so on for thousands),
    // and --follow makes ripgrep walk the targets over and over.
    "search.followSymlinks": false,
    "search.useIgnoreFiles": true,

    // Excluded from SEARCH and Go-to-File, not from the Explorer tree: these
    // stay visible and browsable, they are just not crawled. (files.exclude
    // would hide them outright, which is a bigger change than the problem
    // warrants.)
    "search.exclude": {
        "**/miniconda3/**": true,
        "**/miniforge3/**": true,
        "**/.conda/**": true,
        "**/.anaconda/**": true,
        "**/snap/**": true,
        "**/.cache/**": true,
        "**/.vscode-server/**": true,
        "**/.vscode/extensions/**": true,
        "**/.texlive2025/**": true,
        "**/.wine/**": true,
        "**/.tor-browser/**": true,
        "**/.waterfox/**": true,
        "**/.mozilla/**": true,
        "**/.thunderbird/**": true,
        "**/.minikube/**": true,
        "**/.docker/**": true,
        "**/.dotnet/**": true,
        "**/.java/**": true,
        "**/.npm/**": true,
        "**/.nvm/**": true,
        "**/go/pkg/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/.venv/**": true,
        "**/venv/**": true
    },

    // The file WATCHER is a separate cost from the indexer — an inotify watch
    // per directory, which on a tree this size is both slow to set up and
    // capable of exhausting the per-user watch limit. Same list.
    "files.watcherExclude": {
        "**/miniconda3/**": true,
        "**/miniforge3/**": true,
        "**/.conda/**": true,
        "**/.anaconda/**": true,
        "**/snap/**": true,
        "**/.cache/**": true,
        "**/.vscode-server/**": true,
        "**/.vscode/extensions/**": true,
        "**/.texlive2025/**": true,
        "**/.wine/**": true,
        "**/.tor-browser/**": true,
        "**/.waterfox/**": true,
        "**/.mozilla/**": true,
        "**/.thunderbird/**": true,
        "**/.minikube/**": true,
        "**/.docker/**": true,
        "**/.dotnet/**": true,
        "**/.java/**": true,
        "**/.npm/**": true,
        "**/.nvm/**": true,
        "**/go/pkg/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/.venv/**": true,
        "**/venv/**": true
    },

    // ── Desktop accent ──────────────────────────────────────────────────────
    // ⚠ THE HEXES BELOW ARE GENERATED. This file is in set-accent.sh's
    // manifest, so SUPER+ALT+C rewrites it from
    // theme/templates/vscode-settings.json. Edit it freely — but run
    //     ~/.config/hypr/set-accent.sh --resync
    // afterwards, or the next accent change silently reverts your edit.
    // That includes edits VS CODE ITSELF makes: changing the zoom with
    // Ctrl+= writes window.zoomLevel back here, and it is just as losable.
    // No other file in the manifest rewrites itself, so this is the one to
    // watch.
    //
    // WHY ONLY THESE KEYS: the theme tints 79 colours with the accent, but
    // most are semantic, not chrome — editorBracketHighlight.foreground6,
    // symbolIcon.keywordForeground, charts.purple, the gitlens graph lanes.
    // Repainting those would recolour language keywords and bracket pairs,
    // which is the same reason set-accent.sh leaves the .tmTheme files alone
    // ("syntax highlighting stays Catppuccin on purpose"). So this list is
    // deliberately the UI chrome you read as "the accent", and nothing that
    // carries meaning in the code itself.
    "workbench.colorCustomizations": {
        "[Catppuccin Mocha][Catppuccin Latte]": {
            "focusBorder": "#@@ACCENT@@",
            "sash.hoverBorder": "#@@ACCENT@@",
            "button.background": "#@@ACCENT@@",
            "extensionButton.prominentBackground": "#@@ACCENT@@",
            "activityBarBadge.background": "#@@ACCENT@@",
            "sideBarTitle.foreground": "#@@ACCENT@@",
            "panelTitle.activeBorder": "#@@ACCENT@@",
            "tab.activeBorderTop": "#@@ACCENT@@",
            "tab.activeForeground": "#@@ACCENT@@",
            "terminal.tab.activeBorder": "#@@ACCENT@@",
            "progressBar.background": "#@@ACCENT@@",
            "inputOption.activeBorder": "#@@ACCENT@@",
            "list.highlightForeground": "#@@ACCENT@@",
            "pickerGroup.foreground": "#@@ACCENT@@",
            "editorLineNumber.activeForeground": "#@@ACCENT@@",
            "commandCenter.activeBorder": "#@@ACCENT@@",
            "textLink.foreground": "#@@ACCENT@@",
            "icon.foreground": "#@@ACCENT@@",
            "activityBar.foreground": "#@@ACCENT@@",
            "activityBarTop.foreground": "#@@ACCENT@@",
            "breadcrumb.activeSelectionForeground": "#@@ACCENT@@",
            "breadcrumb.focusForeground": "#@@ACCENT@@",
            "editorSuggestWidget.highlightForeground": "#@@ACCENT@@",
            "editorLink.activeForeground": "#@@ACCENT@@",
            "settings.modifiedItemIndicator": "#@@ACCENT@@",
            "statusBarItem.prominentForeground": "#@@ACCENT@@",
            "notificationCenter.border": "#@@ACCENT@@",
            "notifications.border": "#@@ACCENT@@",
            "notificationToast.border": "#@@ACCENT@@",
            "peekView.border": "#@@ACCENT@@",
            "pickerGroup.border": "#@@ACCENT@@",
            "checkbox.foreground": "#@@ACCENT@@",
            "dropdown.border": "#@@ACCENT@@",
            "tab.hoverForeground": "#@@ACCENT@@",
            "tab.lastPinnedBorder": "#@@ACCENT@@",
            "textSeparator.foreground": "#@@ACCENT@@",
            "debugIcon.stepOverForeground": "#@@ACCENT@@",
            "welcomePage.progress.foreground": "#@@ACCENT@@",
            "editorGutter.commentGlyphForeground": "#@@ACCENT@@",
            "selection.background": "#@@ACCENT@@66",
            "minimapSlider.background": "#@@ACCENT@@33",
            "minimapSlider.hoverBackground": "#@@ACCENT@@66",
            "minimapSlider.activeBackground": "#@@ACCENT@@99",
            "tab.unfocusedActiveBorderTop": "#@@ACCENT@@4d",
            "list.dropBackground": "#@@ACCENT@@33",
            "editorGroup.dropBackground": "#@@ACCENT@@33",
            "sideBar.dropBackground": "#@@ACCENT@@33",
            "terminal.dropBackground": "#@@ACCENT@@33",
            "activityBar.dropBorder": "#@@ACCENT@@33",
            "button.foreground": "#1e1e2e",
            "extensionButton.prominentForeground": "#1e1e2e",
            "activityBarBadge.foreground": "#1e1e2e"
        }
    },
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    }
}
