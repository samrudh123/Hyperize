# ─── Ghostty · Catppuccin Mocha ───────────────────────────────────────────

font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-feature = calt
font-feature = liga
font-thicken = true

# Catppuccin Mocha
background = 282828
foreground = ebdbb2
# Accent — filled in by set-accent.sh; SIGUSR2 reloads open windows
cursor-color = @@ACCENT@@
cursor-text = 141617
# selected text turns accent on a muted band, rather than an accent slab
selection-background = 3c3836
selection-foreground = @@ACCENT@@
split-divider-color = @@ACCENT@@
unfocused-split-fill = 141617
# Ctrl+Shift+F search: matches muted, the current match in the accent
search-background = 504945
search-foreground = ebdbb2
search-selected-background = @@ACCENT@@
search-selected-foreground = 141617

palette = 0=#3c3836
palette = 1=#fb4934
palette = 2=#b8bb26
palette = 3=#fabd2f
palette = 4=#83a598
palette = 5=#e396ac
palette = 6=#8ec07c
palette = 7=#bdae93
palette = 8=#504945
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#e396ac
palette = 14=#8ec07c
palette = 15=#a89984
# accent slots in the 256-colour cube, for the shell (starship prompt,
# fastfetch, eza, completion, fzf all draw with 38;5;53-57). Text keeps the
# palette INDEX, so a reload (set-accent.sh sends SIGUSR2) recolours
# everything already on screen, scrollback included.
palette = 53=#@@ACCENT@@
palette = 54=#@@ACCENT_COMP@@
palette = 55=#@@ACCENT_MID@@
palette = 56=#@@ACCENT_LOW@@
palette = 57=#@@ACCENT_THIRD@@

# ─── Look & feel ──────────────────────────────────────────────────────────
background-opacity = 0.92
background-blur-radius = 32
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = true
window-theme = ghostty
gtk-titlebar = false
unfocused-split-opacity = 0.7

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
scrollback-limit = 100000
copy-on-select = clipboard
confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ─── Keybinds ─────────────────────────────────────────────────────────────
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
