@OBSThemeMeta {
    name: 'Mocha (desktop accent)';
    id: 'com.obsproject.Catppuccin.MochaRice';
    extends: 'com.obsproject.Catppuccin';
    author: 'Xurdejl';
    dark: 'true';
}

/* Catppuccin Mocha with the DESKTOP accent: a local variant of
 * Catppuccin_Mocha.ovt (catppuccin/obs). The theme's accent role is
 * "blue" (lavender = its hover, sapphire = its darker shade) — all three are
 * the accent here. Rendered by set-accent.sh from
 * ~/.config/hypr/theme/templates/obs-catppuccin-rice.ovt; edit, then
 * `set-accent.sh --resync`. OBS reads themes at start. */
@OBSThemeVars {
    --ctp_rosewater: #e5d0c9;
    --ctp_flamingo: #d8a7a7;
    --ctp_pink: #c895bf;
    --ctp_mauve: rgb(180, 142, 173);   /* not #hex: that would read as the accent token */
    --ctp_red: #bf616a;
    --ctp_maroon: #a3545c;
    --ctp_peach: #d08770;
    --ctp_yellow: #ebcb8b;
    --ctp_green: #a3be8c;
    --ctp_teal: #8fbcbb;
    --ctp_sky: #88c0d0;
    --ctp_sapphire: #@@ACCENT@@;
    --ctp_blue: #@@ACCENT@@;
    --ctp_lavender: #@@ACCENT@@;
    --ctp_text: #eceff4;
    --ctp_subtext1: #d8dee9;
    --ctp_subtext0: #b0b8c7;
    --ctp_overlay2: #7b88a1;
    --ctp_overlay1: #6f7b94;
    --ctp_overlay0: #616e88;
    --ctp_surface2: #4c566a;
    --ctp_surface1: #434c5e;
    --ctp_surface0: #3b4252;
    --ctp_base: #2e3440;
    --ctp_mantle: #292e39;
    --ctp_crust: #242933;
    --ctp_selection_background: #353649;
}

/*
 * VolumeMeter foreground peak colors are tuned per-flavor.
 * Dark flavors subtract lightness to avoid blowout on dark tracks.
 * Latte adds lightness for contrast on the light track background.
 */
VolumeMeter {
    qproperty-foregroundNominalColor: #6fd266;
    qproperty-foregroundWarningColor: #f7853f;
    qproperty-foregroundErrorColor:   #ec4675;
}

