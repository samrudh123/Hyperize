# ─── Ghostty · Catppuccin Mocha ───────────────────────────────────────────

font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-feature = calt
font-feature = liga
font-thicken = true

# Catppuccin Mocha
background = 2e3440
foreground = eceff4
cursor-color = e5d0c9
cursor-text = 2e3440
selection-background = 3d4454
selection-foreground = eceff4

palette = 0=#434c5e
palette = 1=#bf616a
palette = 2=#a3be8c
palette = 3=#ebcb8b
palette = 4=#5e81ac
palette = 5=#c895bf
palette = 6=#8fbcbb
palette = 7=#d8dee9
palette = 8=#4c566a
palette = 9=#bf616a
palette = 10=#a3be8c
palette = 11=#ebcb8b
palette = 12=#5e81ac
palette = 13=#c895bf
palette = 14=#8fbcbb
palette = 15=#b0b8c7

# ─── Look & feel ──────────────────────────────────────────────────────────
background-opacity = 0.92
background-blur-radius = 32
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = true
window-theme = ghostty
gtk-titlebar = false
unfocused-split-opacity = 0.7

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
scrollback-limit = 100000
copy-on-select = clipboard
confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ─── Keybinds ─────────────────────────────────────────────────────────────
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
