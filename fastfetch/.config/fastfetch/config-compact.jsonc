{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 0,
      "left": 2,
      "right": 1
    },
    "color": {
      "1": "38;5;53",
      "2": "38;5;54"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;5;53",
      "title": "38;5;54"
    },
    "percent": {
      "type": [
        "bar"
      ]
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "width": 12,
      "border": {
        "left": " ",
        "right": " "
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "38;5;53",
        "at": "white",
        "host": "38;5;54"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m╭────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "  󰍹 os     ",
      "keyColor": "38;5;53"
    },
    {
      "type": "kernel",
      "key": "   kernel ",
      "keyColor": "38;5;53"
    },
    {
      "type": "uptime",
      "key": "  󰅐 uptime ",
      "keyColor": "38;5;53"
    },
    {
      "type": "packages",
      "key": "  󰏖 pkgs   ",
      "keyColor": "38;5;53"
    },
    {
      "type": "shell",
      "key": "  󰆍 shell  ",
      "keyColor": "38;5;53"
    },
    {
      "type": "terminal",
      "key": "  󰞷 term   ",
      "keyColor": "38;5;53"
    },
    {
      "type": "wm",
      "key": "  󰖲 wm     ",
      "keyColor": "38;5;54"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m├────────────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "key": "  󰻠 cpu    ",
      "keyColor": "38;5;57",
      "showPeCoreCount": true
    },
    {
      "type": "memory",
      "key": "  󰍛 memory ",
      "keyColor": "38;5;57"
    },
    {
      "type": "disk",
      "key": "  󰋊 disk   ",
      "keyColor": "38;5;57",
      "folders": "/:/home"
    },
    {
      "type": "battery",
      "key": "  󰂄 battery",
      "keyColor": "38;5;57"
    },
    {
      "type": "brightness",
      "key": "  󰃟 bright ",
      "keyColor": "38;5;57"
    },
    {
      "type": "sound",
      "key": "  󰕾 sound  ",
      "keyColor": "38;5;57",
      "format": "{volume-percentage-bar}"
    },
    {
      "type": "wifi",
      "key": "  󰖩 wifi   ",
      "keyColor": "38;5;57",
      "format": "{ssid} · {band} GHz · {signal-quality}%"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m╰────────────────────────────────────────╯"
    }
  ]
}
