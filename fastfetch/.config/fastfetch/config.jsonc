{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    },
    "color": {
      "1": "38;5;53",
      "2": "38;5;54"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;5;53",
      "title": "38;5;54"
    },
    "percent": {
      "type": [
        "bar"
      ]
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "width": 12,
      "border": {
        "left": " ",
        "right": " "
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "38;5;53",
        "at": "white",
        "host": "38;5;54"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m╭────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "  󰍹 os     ",
      "keyColor": "38;5;53"
    },
    {
      "type": "kernel",
      "key": "   kernel ",
      "keyColor": "38;5;53"
    },
    {
      "type": "uptime",
      "key": "  󰅐 uptime ",
      "keyColor": "38;5;53"
    },
    {
      "type": "packages",
      "key": "  󰏖 pkgs   ",
      "keyColor": "38;5;53"
    },
    {
      "type": "shell",
      "key": "   shell  ",
      "keyColor": "38;5;53"
    },
    {
      "type": "terminal",
      "key": "   term   ",
      "keyColor": "38;5;53"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m├────────────────────────────────────────┤"
    },
    {
      "type": "wm",
      "key": "  󰖲 wm     ",
      "keyColor": "38;5;54"
    },
    {
      "type": "theme",
      "key": "  󰉼 theme  ",
      "keyColor": "38;5;54"
    },
    {
      "type": "icons",
      "key": "  󰀻 icons  ",
      "keyColor": "38;5;54"
    },
    {
      "type": "display",
      "key": "  󰍺 display",
      "keyColor": "38;5;54"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m├────────────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "key": "  󰻠 cpu    ",
      "keyColor": "38;5;57",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "  󰢮 gpu    ",
      "keyColor": "38;5;57"
    },
    {
      "type": "memory",
      "key": "   memory ",
      "keyColor": "38;5;57"
    },
    {
      "type": "disk",
      "key": "  󰋊 disk   ",
      "keyColor": "38;5;57"
    },
    {
      "type": "battery",
      "key": "  󰂄 battery",
      "keyColor": "38;5;57"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;88;91;112m╰────────────────────────────────────────╯"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 4,
      "symbol": "circle"
    },
    "break"
  ]
}
