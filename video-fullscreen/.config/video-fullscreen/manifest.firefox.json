{
  "manifest_version": 2,
  "name": "Video fullscreen",
  "version": "1.1.0",
  "description": "Tells Hyprland when a VIDEO is fullscreen (a player's fullscreen button, embedded players included; not F11), so only then is the window drawn fully opaque. Native host: ~/.config/hypr/video-fullscreen.py.",
  "browser_specific_settings": {
    "gecko": {
      "id": "video-fullscreen@samrudh.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": false,
      "run_at": "document_start"
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
