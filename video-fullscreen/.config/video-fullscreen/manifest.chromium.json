{
  "manifest_version": 3,
  "name": "Video fullscreen",
  "version": "1.0.0",
  "description": "Tells Hyprland when a VIDEO is fullscreen (the player's button, not F11), so only then is the window drawn fully opaque. Native host: ~/.config/hypr/video-fullscreen.py.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_start"
  }],
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon.png" }
}
