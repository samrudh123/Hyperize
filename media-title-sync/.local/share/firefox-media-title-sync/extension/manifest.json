{
  "manifest_version": 3,
  "name": "Media Title Sync",
  "version": "1.1.0",
  "description": "Keeps the media notification title current on streaming sites that play video in an iframe and switch episodes without reloading (AnimeKai, AnimeSuge, …).",
  "browser_specific_settings": {
    "gecko": {
      "id": "media-title-sync@samrudh.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": [
        "frame.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "js": [
        "top.js"
      ]
    },
    {
      "matches": [
        "*://*/*"
      ],
      "include_globs": [
        "*://animekai.*/*",
        "*://*.animekai.*/*"
      ],
      "run_at": "document_idle",
      "js": [
        "animekai.js"
      ]
    }
  ]
}
