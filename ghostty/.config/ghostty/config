# ─── Ghostty · Catppuccin Mocha ───────────────────────────────────────────

font-family = "JetBrainsMono Nerd Font"
font-size = 12
font-feature = calt
font-feature = liga
font-thicken = true

# Catppuccin Mocha
background = 1a1b26
foreground = c0caf5
# Accent — filled in by set-accent.sh; SIGUSR2 reloads open windows
cursor-color = babdc1
cursor-text = 13131a
# selected text turns accent on a muted band, rather than an accent slab
selection-background = 343a52
selection-foreground = babdc1
split-divider-color = babdc1
unfocused-split-fill = 13131a
# Ctrl+Shift+F search: matches muted, the current match in the accent
search-background = 414868
search-foreground = c0caf5
search-selected-background = babdc1
search-selected-foreground = 13131a

palette = 0=#343a52
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#fca7ea
palette = 6=#73daca
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#fca7ea
palette = 14=#73daca
palette = 15=#9aa5ce
# accent slots in the 256-colour cube, for the shell (starship prompt,
# fastfetch, eza, completion, fzf all draw with 38;5;53-56). Text keeps the
# palette INDEX, so a reload (set-accent.sh sends SIGUSR2) recolours
# everything already on screen, scrollback included.
palette = 53=#babdc1
palette = 54=#82888f
palette = 55=#606471
palette = 56=#424656

# ─── Look & feel ──────────────────────────────────────────────────────────
background-opacity = 0.92
background-blur-radius = 32
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = true
window-theme = ghostty
gtk-titlebar = false
unfocused-split-opacity = 0.7

cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
scrollback-limit = 100000
copy-on-select = clipboard
confirm-close-surface = false
shell-integration = detect
shell-integration-features = cursor,sudo,title

# ─── Keybinds ─────────────────────────────────────────────────────────────
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backslash=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+z=toggle_split_zoom
keybind = ctrl+shift+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
