# backups left by in-place edits (name.pre-something, name.bak…)
*.pre-*
*.bak
*.bak-*
*.orig
*.tmp
*~
__pycache__/
*.pyc

# never commit: BitLocker key file option in mount-windows.sh
hypr/.config/hypr/.windows-key

# per-machine identity
.gitconfig.local
hypr/.config/hypr/spotify-client-id
hypr/.config/hypr/media-tests/

# runtime state: the current wallpaper's absolute path (set-wallpaper.sh)
hypr/.config/hypr/wallpaper

# per-machine: the weather pill's place (weather.py locate)
hypr/.config/hypr/weather-location

# vscode-pdf-zathura: the .vsix is build.sh's output; the pre-patch download
vscode-pdf-zathura/.config/vscode-pdf-zathura/*.vsix
vscode-pdf-zathura/.config/vscode-pdf-zathura/*.orig-download
vscode-pdf-zathura/.config/vscode-pdf-zathura/firefox/*.xpi

# firefox-accent: the .xpi is build.sh's output
firefox-accent/.config/firefox-accent/*.xpi

# dl-popup: the .xpi is build.sh's output (signed copies come from AMO)
dl-popup/.local/share/dl-popup/*.xpi

# video-fullscreen: build.sh's outputs (xpi to sign, unpacked Chromium copy)
video-fullscreen/.config/video-fullscreen/*.xpi
video-fullscreen/.config/video-fullscreen/chromium/

# mpris-position / media-title-sync: the .xpi is build.sh's output
mpris-position/.local/share/firefox-mpris-position/*.xpi
media-title-sync/.local/share/firefox-media-title-sync/*.xpi

# set-accent.sh's per-theme template cache (tpl_for rebuilds it on demand)
hypr/.config/hypr/theme/rendered/
