{
  "manifest_version": 2,
  "name": "PDF in Zathura",
  "version": "1.4.0",
  "description": "Opens PDFs in a zathura-style viewer instead of Firefox's built-in one: zathura's keys, statusbar, index and recolour, themed from zathurarc.",
  "browser_specific_settings": {
    "gecko": {
      "id": "pdf-zathura@samrudh.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "webRequest", "webRequestBlocking", "<all_urls>", "nativeMessaging", "downloads", "clipboardWrite", "cookies"
  ],
  "background": { "scripts": ["background.js"] },
  "page_action": {
    "default_title": "Open in Firefox's PDF viewer",
    "default_icon": "icon.svg"
  },
  "web_accessible_resources": ["viewer.html"],
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval' blob:; object-src 'self'",
  "icons": { "48": "icon.svg", "96": "icon.svg" }
}
